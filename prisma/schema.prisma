// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model User {
  id            String   @id @default(uuid()) @map("_id")
  email         String   @unique
  firstname     String
  lastName      String
  phone         String
  birthDay      DateTime
  country       String?
  language      String?
  currency      String   @default("EUR")
  accountType   String // 'traveler' | 'host'
  password      String?
  loginProvider String   @default("email")
  isActive      Boolean  @default(true)

  // Relations for Message
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  listings         Listing[]

  @@map("users")
}

model Message {
  id         String   @id @default(uuid()) @map("_id")
  senderId   String? // null for system messages
  receiverId String
  type       String   @default("user") // 'user' | 'admin' | 'system'
  subject    String
  content    String
  status     String   @default("unread") // 'unread' | 'read' | 'archived'
  isRead     Boolean  @default(false)
  readAt     DateTime?

  sender   User? @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  receiver User  @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId, status])
  @@index([receiverId, createdAt])
  @@map("messages")
}


model Listing {
  id          String   @id @default(uuid()) @map("_id")
  hostId      String
  title       String
  propertyType String
  description String

  // Location
  city        String
  country     String
  address     String?
  postalCode  String?

  // Capacity
  maxGuests   Int
  bedrooms    Int
  beds        Int
  bathrooms   Int
  amenities   String[] // Array of amenity codes

  // Photos
  photos          String[] // Array of image URLs
  mainPhotoIndex  Int      @default(0)

  // Pricing
  pricePerNight      Float
  cleaningFee        Float    @default(0)
  minNights          Int      @default(1)
  maxNights          Int      @default(30)
  cancellationPolicy String

  // Status
  status      String   @default("draft") // 'draft' | 'active' | 'inactive'
  isPublished Boolean  @default(false)

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([city, country])
  @@index([status, isPublished])
  @@map("listings")
}